# syntax=docker/dockerfile:1.7

ARG FRONTEND_DEPS_IMAGE
FROM ${FRONTEND_DEPS_IMAGE} AS frontend-builder

WORKDIR /frontend

# node_modules already exists in the dependency image.
# Only the patched source is copied for normal Weekly Leftovers revisions.
COPY frontend .

RUN yarn generate

ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS production

ARG COMMIT
ENV GIT_COMMIT_HASH=${COMMIT}

# Keep the complete, tested upstream backend/runtime and replace only its static
# frontend bundle. This avoids rebuilding Python, pip, apt, ffmpeg, LDAP libs,
# NLTK, etc. for a frontend-only Weekly Leftovers patch.
COPY --from=frontend-builder /frontend/dist /tmp/mealie-weekly-leftovers-frontend

RUN python3 - <<'PY'
from pathlib import Path
from importlib.util import find_spec
import shutil

spec = find_spec("mealie")
if spec is None or not spec.submodule_search_locations:
    raise SystemExit("Could not locate installed Mealie package")

package_dir = Path(next(iter(spec.submodule_search_locations)))
target = package_dir / "frontend"
source = Path("/tmp/mealie-weekly-leftovers-frontend")

if not source.is_dir():
    raise SystemExit(f"Missing generated frontend: {source}")

if target.exists():
    shutil.rmtree(target)

shutil.copytree(source, target)
shutil.rmtree(source)
print(f"Installed patched frontend into {target}")
PY
